# Copy to .env and change the password. .env is never committed.
# Put values with special characters in single quotes ('...'): Docker Compose and
# `source .env` in a shell only read them the same way when quoted.
POSTGRES_USER=gemeindespiegel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gemeindespiegel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
